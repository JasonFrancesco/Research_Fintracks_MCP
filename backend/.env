DATABASE_URL=postgresql://postgres:Admin123@localhost:5432/fintracks
SECRET_KEY=limit_kalkulus
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ganti ACTIVE_MODEL untuk berpindah model AI di Ollama TANPA mengubah kode.
# Pastikan model sudah di-pull terlebih dahulu, misal: ollama pull gemma:31b
# Contoh nilai lain yang valid: ollama/llama3.2, ollama/gemma:31b, ollama/mistral, dst.
ACTIVE_MODEL=ollama/ministral-3:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300

# ===========================================================================
# KONFIGURASI MODEL CLOUD
# ===========================================================================
# CLOUD_PROVIDER menentukan endpoint mana yang dipakai saat Mode AI = Cloud.
# Pilihan valid: groq | ollama_cloud | openrouter | gemini | openai
CLOUD_PROVIDER=groq

# --- Provider aktif: GROQ (https://console.groq.com/keys) --------------------
# Key Groq berformat: gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=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
# Model Groq yang mendukung function calling (cek https://console.groq.com/docs/models):
#   openai/gpt-oss-120b  -> paling pintar, direkomendasikan untuk MCP tool calling
#   openai/gpt-oss-20b   -> paling cepat
#   qwen/qwen3.8-27b     -> alternatif
CLOUD_MODEL=openai/gpt-oss-120b

# --- Alternatif: OLLAMA CLOUD (https://ollama.com/settings/keys) -------------
# Key di bawah sudah diverifikasi VALID (tes gemma4:31b + tool calling berhasil).
OLLAMA_API_KEY=8c2b0f82e4224e8d893c5f823db41849.soqgEpREW7-6Jw6DN20YMF10
# Cara pakai: ubah CLOUD_PROVIDER=ollama_cloud dan CLOUD_MODEL ke salah satu di bawah:
#   gpt-oss:120b, gpt-oss:20b, gemma4:31b, glm-5.3, kimi-k3,
#   deepseek-v4.1-flash, minimax-m3, nemotron-3-nano:30b, mistral-large-3:675b

# --- Alternatif lain (isi salah satu bila ingin dipakai) ---------------------
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Hanya untuk gateway/proxy khusus (LiteLLM, Open WebUI). Kosongkan jika tidak perlu.
# Nilai ini menimpa base URL provider di atas.
# CLOUD_BASE_URL=

CLOUD_TIMEOUT=60





# --- Override model per preset dropdown Chatbot (opsional) -------------------
# Preset "gpt"   -> provider groq        (default: openai/gpt-oss-120b)
# Preset "gemma" -> provider ollama_cloud (default: gemma4:31b)
# Preset "local" -> mengikuti ACTIVE_MODEL di atas
# Berguna untuk membandingkan akurasi tool calling antar model saat penelitian.
# PRESET_GPT_MODEL=openai/gpt-oss-20b
# PRESET_GEMMA_MODEL=gemma4:31b
